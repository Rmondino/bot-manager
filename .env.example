# Copiá este archivo a .env y completá los valores.
# .env está gitignoreado — nunca se sube al repo.

# --- Postgres de n8n ---
POSTGRES_N8N_PASSWORD=

# --- Postgres del backend ---
POSTGRES_BACKEND_PASSWORD=

# --- n8n ---
# Clave fija de encriptación de credenciales de n8n. Generá una y no la cambies
# (si la cambiás, n8n no puede desencriptar las credenciales ya guardadas).
N8N_ENCRYPTION_KEY=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
