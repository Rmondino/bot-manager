      "name": "Enviar mensaje seguimiento"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Preparar mensaje seguimiento').item.json;\nconst nombre = lead.Nombre || 'Sin nombre';\nconst whatsapp = lead.WhatsApp || '';\n\nconst notif = `⏰ Seguimiento enviado:\\n👤 ${nombre}\\n📱 ${whatsapp}\\n\\nEl lead pasó a modo HUMANO. Esperando tu contacto.`;\n\nreturn [{ json: { text: notif, encargado_numero: lead.encargado_numero } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
