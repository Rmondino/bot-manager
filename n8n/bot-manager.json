        "jsCode": "const agentOutput = $('AI Agent').first().json.output || '';\nconst nombre = $('Normalizacion1').first().json.user.name || 'Lead';\nconst whatsapp = $('Normalizacion1').first().json.message.chat_id.replace('@s.whatsapp.net','');\n\n// Datos del inmueble desde Sheets (vienen del nodo Buscar lead en Sheets)\nconst leadData = $('Releer lead actualizado').first().json;\nconst tipoInmueble = leadData['Tipo inmueble'] || 'Sin datos';\nconst zona = leadData['Zona'] || 'Sin datos';\nconst superficie = leadData['Superficie m²'] || 'Sin datos';\n\nconst notif = '🔥 Lead listo para cerrar:\\n' +\n              '👤 ' + nombre + '\\n' +\n              '📱 ' + whatsapp + '\\n' +\n              '🏠 ' + tipoInmueble + ' en ' + zona + '\\n' +\n              '📐 ' + superficie + ' m²';\n\nconst textoLead = agentOutput.replace('##LISTO_PARA_CERRAR##', '').trim();\n\nreturn [{ json: { texto_lead: textoLead, notif_encargado: notif } }];"
      },
