    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst config = $('Parsear CONFIG').first().json;\n\nconst nombre = lead.Nombre || 'cliente';\nconst empresa = config.nombre_empresa || 'nosotros';\nconst plantilla = config.mensaje_seguimiento || 'Hola {nombre}, te contactamos desde {empresa}. ¿Pudiste ver la info?';\n\nconst mensaje = plantilla\n  .replace('{nombre}', nombre)\n  .replace('{empresa}', empresa);\n\nreturn [{\n  json: {\n    ...lead,\n    mensaje_seguimiento: mensaje,\n    encargado_numero: config.encargado_numero,\n    server_url: config.server_url || '',\n    instance_name: config.instance_name || '',\n    apikey: config.apikey || ''\n  }\n}];"
